Middle of Linked List

/* Linked List Node Structure
class Node{
    constructor(data){
        this.data = data;
        this.next = null;
    }
} */

/**
 * @param {Node} head
 * @return {number}
 */
class Solution {
    getMiddle(head) {
        // code here
        if(!head)return -1;
         let slow = head,fast = head;
        while(fast && fast.next){
            slow = slow.next;
            fast = fast.next.next;
        }
        return slow.data;
    }
}
