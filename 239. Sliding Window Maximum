/**
 * @param {number[]} nums
 * @param {number} k
 * @return {number[]}
 */
var maxSlidingWindow = function (nums, k) {
    let n = nums.length, deque = [], ans = [];


    for (let i = 0; i < n; i++) {
        

        if (deque.length > 0 && deque[0] <= i - k) {
            deque.shift();
        }
        while (deque.length > 0 && nums[i] >= nums[deque[deque.length - 1]]) {
            deque.pop();
        }
        deque.push(i);

        if (i >= k - 1) {
            ans.push(nums[deque[0]]);
        }
    }
    return ans;
};
