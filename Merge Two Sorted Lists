var mergeTwoLists = function (list1, list2) {
    let head1 = list1, head2 = list2;
    let ans = new ListNode(-1);
    let ansHead = ans;
    while (head1 && head2) {
        if (head1.val <= head2.val) {
            ans.next=head1;
            head1=head1.next;
            ans=ans.next;
        }
        else {
            ans.next=head2;
            head2=head2.next;
            ans=ans.next;
        }
    }
    if (head1) {
        ans.next=head1
    }
    if (head2) {
      ans.next=head2;
    }
    console.log(ansHead);
    return ansHead.next;
};
