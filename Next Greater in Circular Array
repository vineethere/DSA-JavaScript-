class Solution {
    nextGreater(arr) {

        let n = arr.length;

        let stack = [];
        let ans = new Array(2 * n).fill(-1);

        let end = 2 * n - 1;

        let tempArray = [...arr, ...arr];

        while (end >= 0) {

            while (
                stack.length &&
                stack[stack.length - 1] <= tempArray[end]
            ) {
                stack.pop();
            }

            if (stack.length !== 0) {
                ans[end] = stack[stack.length - 1];
            }

            stack.push(tempArray[end]);

            end--;
        }
while (ans.length > n) {
    ans.pop();
}

        return ans;
    }
}
