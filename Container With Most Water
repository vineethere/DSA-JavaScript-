/**
 * @param {number[]} height
 * @return {number}
 */
var maxArea = function(height) {
    let i=0,j=height.length-1;
    let ans =-Infinity;
    while(i<j){
        
        let waterStored = (j-i)*Math.min(height[i],height[j]);
        ans=Math.max(ans,waterStored);
        if(height[i]<height[j]){
            i++;
        }
        else{
            j--;
        }

    }
return ans;
};
