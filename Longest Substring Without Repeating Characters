/**
 * @param {string} s
 * @return {number}
 */
var lengthOfLongestSubstring = function (s) {
    let start = 0, end = 0, ans = 0;
    let map = new Map();

    while (end < s.length) {
        if (map.has(s[end])) {
            while (s[start] !== s[end]) {
                map.delete(s[start])
                start++;
            }
            start++;
        }

        else {
            map.set(s[end], 0);
        }
        ans = Math.max(ans, end - start + 1);
        end++;
    }
    return ans;
};






