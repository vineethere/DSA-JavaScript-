Brute force: 
/**
 * @param {number[]} temperatures
 * @return {number[]}
 */
var dailyTemperatures = function(tempratures) {
    let n=tempratures.length;
    let ans = new Array(n).fill(0);
    for(let i=0;i<n;i++){
        for(let j=i+1;j<n;j++){
            if(tempratures[j]>tempratures[i]){
                ans[i]=j-i;
                break;
            }
        }
    }
    return ans;
};



Optmimized approach

/**
 * @param {number[]} temperatures
 * @return {number[]}
 */
//  stack -> [index,element]
var dailyTemperatures = function (temperatures) {
    let stack = [];
    let n = temperatures.length;
    let ans = new Array(n).fill(0);
    let end = n - 1
    while (end >= 0) {
        while (stack.length && temperatures[stack[stack.length - 1]] <= temperatures[end]) {
            stack.pop();
        }
      
        if (stack.length) {
            ans[end] = (stack[stack.length - 1] - end);
        }

        stack.push(end--);

    }

    return ans;
};
