/**
 * @param {number[]} arr
 * @param {number} k
 * @return {number}
 */

class Solution {
    maxSubarraySum(arr, k) {
    let i=0,j=0,ans=0,sum=0,n=arr.length;
    while(j<k){
       sum+=arr[j];
          ans=Math.max(ans,sum);
       j++;
    
    }
      while(j<n){
        sum+=arr[j++];
        sum-=arr[i++];
          ans=Math.max(ans,sum);
    }
    return ans;
    
    
    }
}
